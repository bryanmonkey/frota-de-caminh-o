def estatisticas():
 
    print("\n======== ESTATÍSTICAS DA FROTA ========")
 
    if len(frota) == 0:
        print("Nenhum caminhão cadastrado.")
        return
 
    total = len(frota)
 
    sp = 0
    pr = 0
    mg = 0
    rj = 0
    outros = 0
 
    for caminhao in frota:
 
        estado = caminhao["estado"]
 
        if estado == "SP":
            sp += 1
 
        elif estado == "PR":
            pr += 1
 
        elif estado == "MG":
            mg += 1
 
        elif estado == "RJ":
            rj += 1
 
        else:
            outros += 1
 
    print("Total de caminhões:", total)
    print("Caminhões de SP:", sp)
    print("Caminhões de PR:", pr)
    print("Caminhões de MG:", mg)