# 8 - ALTERAR CAMINHÃO
# ==========================================
 
def alterar_caminhao():
 
    print("\n======== ALTERAR CAMINHÃO ========")
 
    placa = normalizar(input("Digite a placa do caminhão: "))
 
    for caminhao in frota:
 
        if caminhao["placa"] == placa:
 
            print("\nCaminhão encontrado!")
            print("Deixe o campo vazio para manter a informação atual.")
 
            novo_modelo = input("Novo modelo: ")
            novo_motorista = input("Novo motorista: ")
            nova_cidade = input("Nova cidade: ")
            novo_estado = input("Novo estado: ")
            nova_carga = input("Nova carga: ")
            novo_ano = input("Novo ano: ")
 
            if novo_modelo != "":
                caminhao["modelo"] = normalizar(novo_modelo)
 
            if novo_motorista != "":
                caminhao["motorista"] = normalizar(novo_motorista)
 
            if nova_cidade != "":
                caminhao["cidade"] = normalizar(nova_cidade)
 
            if novo_estado != "":
                caminhao["estado"] = normalizar_estado(novo_estado)
 
            if nova_carga != "":
                caminhao["carga"] = normalizar(nova_carga)
 
            if novo_ano != "":
                try:
                    novo_ano = int(novo_ano)
 
                    if novo_ano <= 0:
                        print("Ano inválido. O ano não foi alterado.")
                    else:
                        caminhao["ano"] = novo_ano
 
                except ValueError:
                    print("Digite apenas números para o ano.")
                    return
 
            print("\nCaminhão alterado com sucesso!")
            return
 
    print("\nCaminhão não encontrado.")
 
 
# ==========================================
# 9 - REMOVER CAMINHÃO
# ==========================================
 
def remover_caminhao():
 
    print("\n======== REMOVER CAMINHÃO ========")
 
    placa = normalizar(input("Digite a placa do caminhão: "))
 
    for caminhao in frota:
 
        if caminhao["placa"] == placa:
 
            print("\nCaminhão encontrado!")
            print("Placa:", caminhao["placa"])
            print("Modelo:", caminhao["modelo"])
            print("Motorista:", caminhao["motorista"])
 
            confirmacao = input(
                "\nDeseja realmente remover? Digite S para confirmar ou N para cancelar: "
            ).strip().lower()
 
            if confirmacao == "s":
 
                frota.remove(caminhao)
 
                print("\nCaminhão removido com sucesso!")
 
            elif confirmacao == "n":
 
                print("\nRemoção cancelada.")
 
            else:
 
                print("\nOpção inválida.")
 
            return
 
    print("\nCaminhão não encontrado.")
 
 
