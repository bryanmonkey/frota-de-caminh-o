frota = []
 
 
# ==========================================
# FUNÇÃO PARA NORMALIZAR TEXTO
# ==========================================
 
def normalizar(texto):
    return texto.strip().lower()
 
 
# ==========================================
# FUNÇÃO PARA NORMALIZAR ESTADO
# ==========================================
 
def normalizar_estado(estado):
    estado = estado.strip().lower()
 
    estados = {
        "são paulo": "SP",
        "sao paulo": "SP",
        "sp": "SP",
 
        "paraná": "PR",
        "parana": "PR",
        "pr": "PR",
 
        "minas gerais": "MG",
        "mg": "MG",
 
        "rio de janeiro": "RJ",
        "rj": "RJ",
 
        "santa catarina": "SC",
        "sc": "SC",
 
        "rio grande do sul": "RS",
        "rs": "RS",
 
        "bahia": "BA",
        "ba": "BA",
 
        "goiás": "GO",
        "goias": "GO",
        "go": "GO"
    }
 
    if estado in estados:
        return estados[estado]
 
    return estado.upper()
 
 
# ==========================================
# FUNÇÃO PARA LER O ANO
# ==========================================
 
def ler_ano():
    while True:
        try:
            ano = int(input("Ano do caminhão: "))
 
            if ano <= 0:
                print("Digite um ano válido.")
            else:
                return ano
 
        except ValueError:
            print("Digite apenas números para o ano.")
 
 
# ==========================================
# 1 - CADASTRAR CAMINHÃO
# ==========================================
 
def cadastrar_caminhao():
 
    print("\n======== CADASTRAR CAMINHÃO ========")
 
    placa = normalizar(input("Placa: "))
    modelo = normalizar(input("Modelo: "))
    motorista = normalizar(input("Motorista: "))
    cidade = normalizar(input("Cidade: "))
    estado = normalizar_estado(input("Estado: "))
    carga = normalizar(input("Tipo de carga: "))
    ano = ler_ano()
 
    # Verificar se a placa já existe
    for caminhao in frota:
        if caminhao["placa"] == placa:
            print("\nEssa placa já está cadastrada!")
            return
 
    # Criando o caminhão
    caminhao = {
        "placa": placa,
        "modelo": modelo,
        "motorista": motorista,
        "cidade": cidade,
        "estado": estado,
        "carga": carga,
        "ano": ano
    }
 
    frota.append(caminhao)
 
    print("\nCaminhão cadastrado com sucesso!")
 
 
